{
    "name": "lexcode/laravel-xml-templating",
    "description": "Odoo-ähnliches XML-Templating-System für Laravel",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Dein Name",
            "email": "deine.email@example.com"
        }
    ],
    "require": {
        "php": "^8.0",
        "laravel/framework": "^8.0|^9.0|^10.0|^12.0",
        "ext-dom": "*",
        "ext-libxml": "*"
    },
    "require-dev": {
        "orchestra/testbench": "^6.0|^7.0|^8.0|^10.0",
        "phpunit/phpunit": "^9.0|^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Lexcode\\XmlTemplating\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Lexcode\\XmlTemplating\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Lexcode\\XmlTemplating\\Providers\\XmlTemplatingServiceProvider"
            ],
            "aliases": {
                "TemplateManager": "Lexcode\\XmlTemplating\\Facades\\TemplateManager"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}